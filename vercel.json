{
  "buildCommand": "cd web && npm ci && npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://emotion-agents.fly.dev/api/:path*"
    },
    {
      "source": "/data/:path*",
      "destination": "https://emotion-agents.fly.dev/data/:path*"
    }
  ]
}
